<%- include('../partials/student-header', { activeSection: 'results' , headingMeta: results.length + ' entregas' }) %>
  <section class="workflow-section" aria-labelledby="results-title">
    <h2 id="results-title">Historial de evaluaciones</h2>
    <% if (!results.length) { %>
      <div class="student-empty"><i class="ti ti-chart-bar" aria-hidden="true"></i>
        <h2>Tu progreso empieza aquí</h2>
        <p>Aún no has entregado ningún examen.</p><a href="/student/exams" class="btn btn-primary">Ver exámenes <i
            class="ti ti-arrow-right" aria-hidden="true"></i></a>
      </div>
      <% } else { %>
        <div class="workflow-table-scroll">
          <table class="workflow-table student-results-table">
            <thead>
              <tr>
                <th scope="col">Examen</th>
                <th scope="col">Fecha</th>
                <th scope="col">Puntaje</th>
                <th scope="col">Porcentaje</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              <% results.forEach(result=> { %>
                <tr>
                  <td><strong>
                      <%= result.exam?.title || 'Examen' %>
                    </strong></td>
                  <td>
                    <%= result.createdAt.toLocaleDateString('es') %>
                  </td>
                  <td class="result-score"><strong>
                      <%= result.score %>
                    </strong> / <%= result.total %>
                  </td>
                  <td>
                    <%= result.total> 0 ? Math.round(result.score / result.total * 100) : 0 %>%
                  </td>
                  <td><span class="status-badge <%= result.pendingReview > 0 ? '' : 'status-complete' %>">
                      <%= result.pendingReview> 0 ? 'En revisión' : 'Calificado' %>
                    </span></td>
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
  </section>
  <%- include('../partials/student-footer') %>