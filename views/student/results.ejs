<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="container app-shell" style="max-width: 700px;">
      <div class="theme-toggle-wrapper">
        <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar modo de color">
          <i class="ti ti-moon" aria-hidden="true"></i>
        </button>
      </div>

      <header class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; padding-top: 1.5rem;">
        <div>
          <p class="eyebrow"><i class="ti ti-users" aria-hidden="true"></i> <%= userName %></p>
          <h1>Mis resultados</h1>
        </div>
        <div class="header-actions" style="margin-right: 2.5rem;">
          <a href="/student/exams" class="btn btn-secondary">
            <i class="ti ti-arrow-left" aria-hidden="true"></i> Exámenes
          </a>
          <a href="/logout" class="btn btn-secondary">
            <i class="ti ti-logout" aria-hidden="true"></i> Salir
          </a>
        </div>
      </header>

      <% if (results.length === 0) { %>
      <section class="panel" style="text-align: center; padding: 3rem;">
        <i class="ti ti-chart-bar-off" style="font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem; display: block;"></i>
        <p style="color: var(--text-secondary);">Aún no has rendido ningún examen.</p>
        <a href="/student/exams" class="btn btn-primary" style="margin-top: 1rem;">
          <i class="ti ti-arrow-right" aria-hidden="true"></i> Ver exámenes disponibles
        </a>
      </section>
      <% } else { %>
      <div class="exam-list">
        <% results.forEach((r) => { %>
        <article class="exam-card">
          <div class="exam-card-body">
            <h2 class="exam-card-title"><%= r.exam ? r.exam.title : 'Examen' %></h2>
            <div style="display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem;">
              <div class="score-display" style="font-size: 1.5rem; margin: 0;">
                <span class="score-value" style="font-size: 1.5rem;"><%= r.score %></span>
                <span class="score-total" style="font-size: 1rem;">/ <%= r.total %></span>
              </div>
              <span style="color: var(--text-secondary); font-size: 0.85rem;">
                <i class="ti ti-calendar" aria-hidden="true"></i> <%= r.createdAt.toLocaleDateString() %>
              </span>
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--<%= r.score >= r.total * 0.6 ? 'success' : 'danger' %>);">
                <%= Math.round((r.score / r.total) * 100) %>%
              </span>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </main>
    <script src="/js/themeToggle.js"></script>
  </body>
</html>
