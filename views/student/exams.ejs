<%- include('../partials/student-header', { title: 'Mis exámenes' , activeSection: 'exams' , headingMeta: exams.length
  + ' asignados' }) %>
  <div class="student-overview" aria-label="Resumen de exámenes">
    <div><span class="overview-label">Por completar</span><strong>
        <%= exams.filter(exam=> !resultsMap?.[exam.id]).length %>
      </strong></div>
    <div><span class="overview-label">Entregados</span><strong>
        <%= exams.filter(exam=> resultsMap?.[exam.id]).length %>
      </strong></div>
    <div><span class="overview-label">Invitaciones</span><strong>
        <%= invitations.length %>
      </strong></div>
  </div>
  <div class="student-exam-layout">
    <section aria-labelledby="assigned-title">
      <div class="section-heading">
        <h2 id="assigned-title">Tus evaluaciones</h2><i class="ti ti-notes" aria-hidden="true"></i>
      </div>
      <% if (!exams.length) { %>
        <div class="student-empty"><i class="ti ti-notes-off" aria-hidden="true"></i>
          <h2>Todo al día</h2>
          <p>No tienes exámenes asignados.</p><a href="/student/courses" class="btn btn-secondary"><i
              class="ti ti-books" aria-hidden="true"></i> Ver mis cursos</a>
        </div>
        <% } else { %>
          <div class="student-exam-list">
            <% exams.forEach(exam=> { const taken = resultsMap?.[exam.id]; %>
              <article class="student-exam-row">
                <span class="exam-row-icon" aria-hidden="true"><i
                    class="ti ti-<%= taken ? 'circle-check' : 'file-text' %>"></i></span>
                <div class="exam-row-content">
                  <div class="exam-row-heading">
                    <h3>
                      <%= exam.title %>
                    </h3><span class="status-badge <%= taken ? 'status-complete' : '' %>">
                      <%= taken ? 'Entregado' : 'Pendiente' %>
                    </span>
                  </div>
                  <% if (exam.instructions) { %>
                    <p class="exam-row-description">
                      <%= exam.instructions %>
                    </p>
                    <% } %>
                      <div class="exam-row-meta">
                        <% if (exam.course?.name) { %><span><i class="ti ti-books" aria-hidden="true"></i>
                            <%= exam.course.name %>
                          </span>
                          <% } %>
                            <span><i class="ti ti-calendar" aria-hidden="true"></i>
                              <%= exam.createdAt.toLocaleDateString('es') %>
                            </span>
                            <% if (exam.timeLimitMinutes) { %><span><i class="ti ti-clock" aria-hidden="true"></i>
                                <%= exam.timeLimitMinutes %> min
                              </span>
                              <% } %>
                                <% if (taken) { %><span>
                                    <%= taken.score %> / <%= taken.total %> puntos
                                  </span>
                                  <% } %>
                                    <% if (taken?.pendingReview> 0) { %><span><i class="ti ti-clock"
                                          aria-hidden="true"></i> Revisión pendiente (<%= taken.pendingReview %>)</span>
                                      <% } %>
                      </div>
                </div>
                <div class="exam-row-actions">
                  <% if (exam.leaderboardEnabled) { %><a href="/student/exams/<%= exam.id %>/leaderboard"
                      class="btn btn-secondary" title="Ranking de <%= exam.title %>"
                      aria-label="Ranking de <%= exam.title %>"><i class="ti ti-trophy" aria-hidden="true"></i></a>
                    <% } %>
                      <% if (taken) { %><a href="/student/results" class="btn btn-secondary">Resultados <i
                            class="ti ti-arrow-up-right" aria-hidden="true"></i></a>
                        <% } else { %><a href="/student/exams/<%= exam.id %>/start" class="btn btn-primary">Comenzar <i
                              class="ti ti-arrow-right" aria-hidden="true"></i></a>
                          <% } %>
                </div>
              </article>
              <% }) %>
          </div>
          <% } %>
    </section>
    <aside class="student-exam-aside" aria-label="Acceso e invitaciones">
      <section class="join-exam">
        <span class="utility-icon"><i class="ti ti-key" aria-hidden="true"></i></span>
        <h2>¿Tienes un código?</h2>
        <form action="/student/exams/join" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="exam-code" class="form-label">Código del examen</label>
          <input id="exam-code" name="code" class="form-input" required maxlength="12" autocomplete="off"
            placeholder="Código de 12 caracteres" />
          <button class="btn btn-primary auth-submit"><i class="ti ti-plus" aria-hidden="true"></i> Unirme al
            examen</button>
        </form>
      </section>
      <% if (invitations.length) { %>
        <section class="student-invitations" aria-labelledby="invitations-title">
          <div class="section-heading">
            <h2 id="invitations-title">Invitaciones</h2><span class="status-badge">
              <%= invitations.length %>
            </span>
          </div>
          <% invitations.forEach(invitation=> { %>
            <article class="invitation-row">
              <h3>
                <%= invitation.exam.title %>
              </h3>
              <p>
                <%= invitation.exam.course?.name || 'Sin curso' %>
              </p>
              <form action="/student/exams/invitations/<%= invitation.id %>/respond" method="POST"
                class="workflow-actions">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button name="action" value="accept" class="btn btn-primary"><i class="ti ti-check"
                    aria-hidden="true"></i> Aceptar</button>
                <button name="action" value="reject" class="btn btn-secondary" title="Rechazar invitación"
                  aria-label="Rechazar invitación a <%= invitation.exam.title %>"><i class="ti ti-x"
                    aria-hidden="true"></i></button>
              </form>
            </article>
            <% }) %>
        </section>
        <% } %>
    </aside>
  </div>
  <%- include('../partials/student-footer') %>