<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %> | Administracion
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>

<body class="admin-page">
    <header class="admin-topbar">
        <a class="admin-brand" href="/admin/dashboard"><i class="ti ti-shield-check" aria-hidden="true"></i>
            Administracion</a>
        <nav class="admin-nav" aria-label="Administracion">
            <a href="/admin/dashboard" <%- active==='dashboard' ? 'aria-current="page"' : '' %>><i
                    class="ti ti-chart-bar" aria-hidden="true"></i> Resumen</a>
            <a href="/admin/users" <%- active==='users' ? 'aria-current="page"' : '' %>><i class="ti ti-users"
                    aria-hidden="true"></i> Usuarios</a>
            <a href="/admin/exams" <%- active==='exams' ? 'aria-current="page"' : '' %>><i class="ti ti-notes"
                    aria-hidden="true"></i> Examenes</a>
        </nav>
        <div class="admin-account">
            <span>
                <%= req.session.userName %>
            </span>
            <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar modo de color"><i class="ti ti-moon"
                    aria-hidden="true"></i></button>
            <a href="/logout" class="btn btn-secondary admin-icon" title="Cerrar sesion" aria-label="Cerrar sesion"><i
                    class="ti ti-logout" aria-hidden="true"></i></a>
        </div>
    </header>
    <main class="admin-main">
        <header class="admin-heading">
            <h1>
                <%= title %>
            </h1>
        </header>
        <% if (notice) { %>
            <div class="alert <%= notice.kind === 'error' ? 'alert-error' : 'admin-success' %>" role="alert">
                <%= notice.message %>
            </div>
            <% } %>