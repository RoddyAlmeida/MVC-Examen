<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/enrollment.css" />
</head>

<body class="membership-page">
    <main class="container app-shell workflow-shell">
        <div class="theme-toggle-wrapper"><button id="theme-toggle" class="theme-toggle"
                aria-label="Cambiar modo de color"><i class="ti ti-moon" aria-hidden="true"></i></button></div>
        <header class="workflow-header">
            <p class="eyebrow">
                <%= req.session.userName %>
            </p>
            <h1>
                <%= title %>
            </h1>
            <nav class="workflow-actions" aria-label="Navegacion">
                <% if (req.session.role==='profesor' ) { %>
                    <a href="/professor/dashboard" class="btn btn-secondary"><i class="ti ti-school"
                            aria-hidden="true"></i> Mis cursos</a>
                    <a href="/professor/notifications" class="btn btn-secondary"><i class="ti ti-bell"
                            aria-hidden="true"></i> Notificaciones <span data-notification-count></span></a>
                    <% } else { %>
                        <a href="/student/courses" class="btn btn-secondary"><i class="ti ti-school"
                                aria-hidden="true"></i> Mis cursos</a>
                        <a href="/student/exams" class="btn btn-secondary"><i class="ti ti-notes"
                                aria-hidden="true"></i> Mis examenes</a>
                        <% } %>
                            <a href="/logout" class="btn btn-secondary" title="Cerrar sesion"
                                aria-label="Cerrar sesion"><i class="ti ti-logout" aria-hidden="true"></i></a>
            </nav>
        </header>
        <% if (actionNotice) { %>
            <div class="alert <%= actionNotice.kind === 'error' ? 'alert-error' : '' %>" role="alert">
                <%= actionNotice.message %>
            </div>
            <% } %>