<link rel="stylesheet" href="/css/feedback.css" />
<script src="/js/pageFeedback.js" defer></script>
<div id="page-feedback" class="page-feedback" data-state="idle" hidden>
    <div class="page-feedback-progress" aria-hidden="true"></div>
    <div class="page-feedback-notice">
        <span class="page-feedback-spinner" aria-hidden="true"></span>
        <p id="page-feedback-message" role="status" aria-live="polite" aria-atomic="true"></p>
        <button id="page-feedback-dismiss" type="button" title="Ocultar aviso" aria-label="Ocultar aviso" hidden><i
                class="ti ti-x" aria-hidden="true"></i></button>
    </div>
</div>