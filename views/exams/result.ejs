<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <!-- Tabler Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/enrollment.css" />
  <link rel="stylesheet" href="/css/student.css" />
</head>

<body class="student-page student-focus">
  <%- include('../partials/student-exam-topbar') %>
    <main class="student-focus-main" data-page-read="Examen finalizado. Revisa tu puntaje o vuelve a tus exámenes.">

      <header class="page-header text-center" style="text-align: center;">
        <p class="eyebrow"><i class="ti ti-award" aria-hidden="true"></i> Resumen final</p>
        <h1>Resultado del examen</h1>
      </header>

      <section class="panel result-hero">
        <div class="score-display">
          <span class="score-value">
            <%= score %>
          </span>
          <span class="score-total">/ <%= total %></span>
        </div>
        <p class="result-message" role="status" aria-live="polite">
          Obtuviste <strong>
            <%= score %>
          </strong> de <strong>
            <%= total %>
          </strong> respuestas correctas.
        </p>
        <% if (typeof pendingReview !=='undefined' && pendingReview> 0) { %>
          <div class="alert" role="status">
            <i class="ti ti-clock" aria-hidden="true"></i> Puntaje provisional: <%= pendingReview %> respuesta(s) de
              concepto esperan revisión del profesor.
          </div>
          <% } %>
      </section>

      <section class="stats-grid" aria-label="Detalle de resultado">
        <article class="stat-card">
          <i class="ti ti-check stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Correctas</p>
          <p class="stat-value">
            <%= score %>
          </p>
        </article>
        <article class="stat-card">
          <i class="ti ti-list-numbers stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Total</p>
          <p class="stat-value">
            <%= total %>
          </p>
        </article>
        <article class="stat-card">
          <i class="ti ti-percentage stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Porcentaje</p>
          <p class="stat-value">
            <%= total> 0 ? Math.round((score / total) * 100) : 0 %>%
          </p>
        </article>
      </section>

      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem;">
        <% if (typeof leaderboardEnabled !=='undefined' && leaderboardEnabled) { %>
          <a class="btn btn-secondary" href="/student/exams/<%= examId %>/leaderboard"><i class="ti ti-trophy"
              aria-hidden="true"></i> Ranking</a>
          <% } %>
            <a class="btn btn-secondary" href="/student/exams" aria-label="Volver a la lista de exámenes"
              data-speak="Volver a la lista de exámenes.">
              <i class="ti ti-arrow-left" aria-hidden="true"></i> Mis exámenes
            </a>
            <a class="btn btn-primary" href="/student/results">Mis resultados <i class="ti ti-arrow-right"
                aria-hidden="true"></i></a>
      </div>
    </main>
    <script src="/js/themeToggle.js"></script>
    <script src="/js/pageNarration.js"></script>
</body>

</html>