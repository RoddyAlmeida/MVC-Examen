<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <!-- Tabler Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/enrollment.css" />
  <link rel="stylesheet" href="/css/student.css" />
</head>

<body class="student-page student-focus">
  <%- include('../partials/student-exam-topbar') %>
    <main class="student-focus-main"
      data-page-read="Bienvenido al sistema de examen en línea. Revisa las indicaciones y presiona Comenzar examen para continuar.">
      <header class="page-header">
        <p class="eyebrow">Antes de comenzar</p>
        <h1>
          <%= exam.title %>
        </h1>
        <p class="lead">
          <%= exam.instructions %>
        </p>
      </header>

      <section class="stats-grid" aria-label="Resumen del examen">
        <article class="stat-card">
          <i class="ti ti-copy stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Preguntas por pantalla</p>
          <p class="stat-value">
            <%= maxItems %>
          </p>
        </article>
        <article class="stat-card">
          <i class="ti ti-layers stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Secciones</p>
          <p class="stat-value">
            <%= totalPages %>
          </p>
        </article>
        <article class="stat-card">
          <i class="ti ti-accessible stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Modo accesible</p>
          <p class="stat-value">Activo</p>
        </article>
        <article class="stat-card">
          <i class="ti ti-clock stat-icon" aria-hidden="true"></i>
          <p class="stat-label">Tiempo limite</p>
          <p class="stat-value">
            <%= exam.timeLimitMinutes ? exam.timeLimitMinutes + ' min' : 'Sin limite' %>
          </p>
        </article>
      </section>

      <% if (exam.securityMode !=="none" ) { %>
        <p class="alert" role="status">
          <%= exam.securityMode==="locked" ? "Modo restringido activo." : "Supervision de pantalla activa." %>
            Los cambios de ventana y salidas se reportan al profesor.
        </p>
        <% } %>
          <% if (startErrors.length) { %>
            <div class="alert alert-error" role="alert">
              <%= startErrors.join(" ") %>
      </div>
      <% } %>
      <form action=" <%=`/student/exams/${exam.id}/begin` %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <% if (exam.passwordHash) { %>
                  <div class="form-group">
                    <label for="examPassword" class="form-label">Contraseña del examen</label>
                    <input id="examPassword" name="password" type="password" class="form-input" autocomplete="off"
                      required maxlength="72" />
                  </div>
                  <% } %>
                    <button class="btn btn-primary" aria-label="Comenzar el examen en línea"><i class="ti ti-pencil"
                        aria-hidden="true"></i> Comenzar examen</button>
                    </form>
    </main>
    <%- include("../partials/page-feedback") %>
      <script src="/js/themeToggle.js"></script>
      <script src="/js/pageNarration.js"></script>
</body>

</html>