<%- include('../partials/admin-dashboard-header') %>
    <section class="dashboard-overview" aria-label="Actividad general">
        <% const overview=[ ['users', 'Usuarios' , metrics.users, `Estudiantes: ${metrics.students} / Profesores:
            ${metrics.professors} / Administradores: ${metrics.administrators}`], ['notes', 'Exámenes' , metrics.exams,
            `${metrics.questions} preguntas en total`], ['list-check', 'Asignaciones activas' , metrics.assignments,
            `Por completar: ${metrics.pendingAssignments}`], ['pencil-check', 'Entregas' , metrics.attempts,
            `${metrics.recentAttempts} en los últimos 7 días`] ]; %>
            <% overview.forEach(([icon, label, value, detail])=> { %>
                <div class="dashboard-metric"><span class="dashboard-metric-label"><i class="ti ti-<%= icon %>"
                            aria-hidden="true"></i>
                        <%= label %>
                    </span><strong>
                        <%= value %>
                    </strong>
                    <p>
                        <%= detail %>
                    </p>
                </div>
                <% }) %>
    </section>
    <div class="dashboard-monitoring">
        <section aria-labelledby="tracking-title">
            <h2 id="tracking-title">Seguimiento académico</h2>
            <strong class="dashboard-progress-value">
                <%= metrics.completionRate %>%
            </strong>
            <p class="dashboard-progress-caption">Asignaciones completadas: <%= metrics.completedAssignments %> / <%=
                        metrics.assignments %>
            </p>
            <meter min="0" max="100" value="<%= metrics.completionRate %>"
                aria-label="Porcentaje de asignaciones completadas">
                <%= metrics.completionRate %>%
            </meter>
            <dl class="dashboard-summary">
                <div>
                    <dt>Pendientes de entrega</dt>
                    <dd>
                        <%= metrics.pendingAssignments %>
                    </dd>
                </div>
                <div>
                    <dt>Entregas en revisión</dt>
                    <dd>
                        <%= metrics.pendingResults %>
                    </dd>
                </div>
                <div>
                    <dt>Respuestas por corregir</dt>
                    <dd>
                        <%= metrics.pendingAnswers %>
                    </dd>
                </div>
            </dl>
        </section>
        <section aria-labelledby="grades-title">
            <h2 id="grades-title">Calificaciones finales</h2>
            <dl class="dashboard-grades">
                <div>
                    <dt>Nota media</dt>
                    <dd>
                        <%= metrics.averageScore===null ? '--' : `${metrics.averageScore}%` %>
                    </dd>
                </div>
                <div>
                    <dt>Aprobación (60%)</dt>
                    <dd>
                        <%= metrics.passRate===null ? '--' : `${metrics.passRate}%` %>
                    </dd>
                </div>
            </dl>
            <p class="dashboard-grading-note">Solo entregas corregidas.</p>
            <% if (metrics.averageScore===null) { %>
                <p class="dashboard-grading-note" role="status">Sin calificaciones finales todavía.</p>
                <% } %>
                    <dl class="dashboard-summary">
                        <div>
                            <dt>Entregas registradas</dt>
                            <dd>
                                <%= metrics.attempts %>
                            </dd>
                        </div>
                        <div>
                            <dt>Últimos 7 días</dt>
                            <dd>
                                <%= metrics.recentAttempts %>
                            </dd>
                        </div>
                    </dl>
        </section>
        <section aria-labelledby="attention-title">
            <h2 id="attention-title">Requieren atención</h2>
            <a class="dashboard-attention<%= metrics.unassignedStudents ? ' has-items' : '' %>"
                href="/admin/users?role=estudiante"><i class="ti ti-user-question"
                    aria-hidden="true"></i><span>Estudiantes sin asignaciones</span><strong>
                    <%= metrics.unassignedStudents %>
                </strong><i class="ti ti-chevron-right" aria-hidden="true"></i></a>
            <a class="dashboard-attention<%= metrics.unownedExams ? ' has-items' : '' %>" href="/admin/exams"><i
                    class="ti ti-notes" aria-hidden="true"></i><span>Exámenes sin autor</span><strong>
                    <%= metrics.unownedExams %>
                </strong><i class="ti ti-chevron-right" aria-hidden="true"></i></a>
        </section>
    </div>
    <section class="dashboard-deliveries" aria-labelledby="deliveries-title">
        <div class="dashboard-section-heading">
            <h2 id="deliveries-title">Últimas entregas</h2><span>
                <%= results.length> 10 ? `10 de ${results.length}` : results.length %> registradas
            </span>
        </div>
        <% if (!results.length) { %>
            <div class="dashboard-empty" role="status"><i class="ti ti-inbox" aria-hidden="true"></i>
                <h3>Sin entregas todavía</h3>
                <p>Las evaluaciones entregadas aparecerán aquí.</p>
            </div>
            <% } else { %>
                <div class="admin-table-scroll">
                    <table class="admin-table" aria-label="Últimas entregas de estudiantes">
                        <thead>
                            <tr>
                                <th scope="col">Estudiante</th>
                                <th scope="col">Examen</th>
                                <th scope="col">Puntaje</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.slice(0, 10).forEach(result=> { const pending = pendingReview(result); %>
                                <tr>
                                    <td><a href="/admin/users/<%= result.userId %>">
                                            <%= result.user?.name || result.user?.email || 'Usuario eliminado' %>
                                        </a></td>
                                    <td>
                                        <%= result.exam?.title || 'Examen eliminado' %>
                                    </td>
                                    <td class="dashboard-score"><strong>
                                            <%= result.score %>
                                        </strong> / <%= result.total %>
                                    </td>
                                    <td><span class="admin-status <%= pending ? 'is-pending' : 'is-complete' %>">
                                            <%= pending ? `${pending} por corregir` : 'Corregido' %>
                                        </span></td>
                                    <td class="dashboard-date"><time datetime="<%= result.createdAt.toISOString() %>">
                                            <%= result.createdAt.toLocaleDateString('es') %>
                                        </time></td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
    </section>
    <footer class="dashboard-footer"><span>MVC Examen</span><span>Administración académica</span></footer>
    <%- include('../partials/admin-footer') %>