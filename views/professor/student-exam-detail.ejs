<%- include('../partials/professor-header', { activeSection: 'students' , pageHeading: result.exam ? result.exam.title
    : 'Revisión del examen' }) %>
    <header class="professor-review-header">
        <a href="/professor/students/<%= student.id %>" class="professor-back"><i class="ti ti-arrow-left"
                aria-hidden="true"></i>
            <%= student.name || student.email %>
        </a>
        <p style="color: var(--text-secondary);">Puntaje: <strong>
                <%= result.score %>
            </strong>/<%= result.total %> · <%= pendingReview ? `${pendingReview} respuestas pendientes de revisión`
                    : 'Calificación completa' %>
        </p>
    </header>
    <form method="POST" action="/professor/students/<%= student.id %>/exam/<%= result.examId %>/review">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="question-list">
            <% questionViews.forEach((view, index)=> { %>
                <article class="question-card">
                    <div class="question-badge" style="margin-bottom: 0.75rem;">Pregunta <%= index + 1 %> · <%=
                                view.type.replaceAll('_', ' ' ) %>
                    </div>
                    <p style="font-weight: 600; margin-bottom: 1rem;">
                        <%= view.question.prompt %>
                    </p>
                    <% if (view.type==='concept' ) { %>
                        <p class="form-label">Respuesta del estudiante</p>
                        <div class="panel">
                            <%= view.answer || 'Sin respuesta' %>
                        </div>
                        <label class="form-label" for="manualScore_<%= view.question.id %>">Calificación
                            manual</label>
                        <select class="form-input" id="manualScore_<%= view.question.id %>"
                            name="manualScore_<%= view.question.id %>">
                            <option value="" <%=view.manualScore===undefined ? 'selected' : '' %>>Pendiente</option>
                            <option value="0" <%=String(view.manualScore)==='0' ? 'selected' : '' %>>No acredita · 0
                                puntos</option>
                            <option value="1" <%=String(view.manualScore)==='1' ? 'selected' : '' %>>Acredita · 1
                                punto</option>
                        </select>
                        <% } else if (view.type==='multiple_choice' ) { %>
                            <% const legacyAnswerIndex=['A', 'B' , 'C' ].indexOf(String(view.answer)); const
                                answerIndex=legacyAnswerIndex>= 0 ? legacyAnswerIndex : Number(view.answer); %>
                                <div class="question-list">
                                    <% view.configuration.options.forEach((option, optionIndex)=> { const text =
                                        typeof option === 'string' ? option : option.text; %>
                                        <div class="option-label"
                                            style="<%= optionIndex === view.configuration.correctIndex ? 'border-color: var(--success); background: var(--success-bg);' : (optionIndex === answerIndex ? 'border-color: var(--danger); background: var(--danger-bg);' : '') %>">
                                            <span class="option-tag">
                                                <%= optionIndex + 1 %>
                                            </span>
                                            <%= text %>
                                                <% if (optionIndex===view.configuration.correctIndex) { %>
                                                    <strong>Correcta</strong>
                                                    <% } %>
                                                        <% if (optionIndex===answerIndex) { %>
                                                            <strong>Elegida</strong>
                                                            <% } %>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else if (view.type==='true_false' ) { %>
                                    <p>Respuesta: <strong>
                                            <%= String(view.answer)==='true' ? 'Verdadero' :
                                                String(view.answer)==='false' ? 'Falso' : 'Sin responder' %>
                                        </strong> · Correcta: <strong>
                                            <%= view.configuration.correctAnswer ? 'Verdadero' : 'Falso' %>
                                        </strong></p>
                                    <% } else if (view.type==='fill_text' ) { %>
                                        <p>Respuesta del estudiante: <strong>
                                                <%= view.answer || 'Sin responder' %>
                                            </strong></p>
                                        <p>Respuestas aceptadas: <%= view.configuration.acceptedAnswers.join(', ') %></p>
              <% } else if (view.type === "fill_drag") { %>
                                                    <p>Respuesta del estudiante: <strong>
                                                            <%= view.answer || ' Sin responder' %>
                                                </strong> · Correcta: <strong>
                                                    <%= view.configuration.answer %>
                                                </strong></p>
                                        <% } else if (view.type==='crossword' ) { %>
                                            <ol class="crossword-review-list">
                                                <% view.configuration.entries.forEach((entry, wordIndex)=> {
                                                    %><li>
                                                        <%= entry.clue %> · estudiante: <strong>
                                                                <%= view.answer?.[wordIndex] || 'Sin responder' %>
                                                            </strong> · correcta: <strong>
                                                                <%= entry.answer %>
                                                            </strong>
                                                    </li>
                                                    <% }) %>
                                            </ol>
                                            <% } %>
                                                <% if (view.type !=='concept' ) { %>
                                                    <p
                                                        style="margin-top: 0.75rem; font-weight: 600; color: var(--<%= view.correct ? 'success' : 'danger' %>);">
                                                        <%= view.correct ? 'Correcta' : 'Incorrecta' %>
                                                    </p>
                                                    <% } %>
                </article>
                <% }) %>
        </div>
        <% if (questionViews.some((view)=> view.type === 'concept')) { %>
            <button type="submit" class="btn btn-primary" style="margin-top: 1rem;"><i class="ti ti-device-floppy"
                    aria-hidden="true"></i> Guardar revisión</button>
            <% } %>
    </form>
    <%- include('../partials/professor-footer') %>