<%- include('../partials/professor-header', { pageHeading: 'Mis cursos' , activeSection: 'courses' }) %>
  <div class="professor-toolbar">
    <% if (courses.length) { %>
      <form action="/professor/dashboard" method="GET" class="professor-course-picker"><label for="courseId"
          class="form-label">Curso activo</label>
        <div class="professor-actions"><select id="courseId" name="courseId" class="form-input">
            <% courses.forEach(item=> { %><option value="<%= item.id %>" <%=course && course.id===item.id ? 'selected'
                : '' %>><%= item.name %>
              </option>
              <% }) %>
          </select><button class="btn btn-secondary" title="Cambiar curso" aria-label="Cambiar curso"><i
              class="ti ti-arrow-right" aria-hidden="true"></i></button></div>
      </form>
      <% } %>
        <% if (course) { %>
          <div class="professor-actions"><a href="/professor/exams/import?courseId=<%= course.id %>"
              class="btn btn-secondary"><i class="ti ti-file-import" aria-hidden="true"></i> Importar QTI</a><a
              href="/professor/exams/create?courseId=<%= course.id %>" class="btn btn-primary"><i class="ti ti-plus"
                aria-hidden="true"></i> Nuevo examen</a></div>
          <% } %>
  </div>
  <% if (!course) { %>
    <section class="professor-empty"><i class="ti ti-books" aria-hidden="true"></i>
      <h2>Sin cursos asignados</h2>
      <p>Contacta al administrador para vincular un curso a tu cuenta.</p>
    </section>
    <% } else { %>
      <div class="professor-overview">
        <div><span>Exámenes</span><strong>
            <%= exams.length %>
          </strong></div>
        <div><span>Curso activo</span><strong class="professor-overview-name">
            <%= course.name %>
          </strong></div><a href="/professor/courses/<%= course.id %>/members"><i class="ti ti-users"
            aria-hidden="true"></i> Integrantes <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a>
      </div>
      <div class="professor-section-heading">
        <h2>Evaluaciones del curso</h2><span class="professor-muted">
          <%= exams.length %> en total
        </span>
      </div>
      <% if (!exams.length) { %>
        <section class="professor-empty"><i class="ti ti-notes" aria-hidden="true"></i>
          <h2>Tu primera evaluación</h2>
          <p>Este curso todavía no tiene exámenes.</p><a href="/professor/exams/create?courseId=<%= course.id %>"
            class="btn btn-primary"><i class="ti ti-plus" aria-hidden="true"></i> Crear examen</a>
        </section>
        <% } else { %>
          <div class="professor-exam-list">
            <% exams.forEach(exam=> { %>
              <article class="professor-exam-row">
                <div class="professor-exam-content">
                  <h3>
                    <%= exam.title %>
                  </h3>
                  <p>
                    <%= exam.instructions %>
                  </p>
                  <div class="professor-exam-meta"><span><i class="ti ti-calendar" aria-hidden="true"></i>
                      <%= exam.createdAt.toLocaleDateString('es') %>
                    </span><span><i class="ti ti-clock" aria-hidden="true"></i>
                      <%= exam.timeLimitMinutes ? exam.timeLimitMinutes + ' min' : 'Sin límite' %>
                    </span>
                    <% if (exam.leaderboardEnabled) { %><a href="/professor/exams/<%= exam.id %>/leaderboard"><i
                          class="ti ti-trophy" aria-hidden="true"></i> Ranking</a>
                      <% } %>
                  </div>
                </div>
                <div class="professor-actions"><a class="btn btn-primary"
                    href="/professor/exams/<%= exam.id %>/questions"><i class="ti ti-notes" aria-hidden="true"></i>
                    Preguntas</a><a class="btn btn-secondary" href="/professor/exams/<%= exam.id %>/access"
                    title="Acceso y seguridad" aria-label="Acceso y seguridad de <%= exam.title %>"><i
                      class="ti ti-lock-access" aria-hidden="true"></i></a><a class="btn btn-secondary"
                    href="/professor/exams/<%= exam.id %>/edit" title="Editar examen"
                    aria-label="Editar <%= exam.title %>"><i class="ti ti-settings" aria-hidden="true"></i></a>
                  <form action="/professor/exams/<%= exam.id %>/delete" method="POST"
                    data-confirm-message="Se eliminará este examen y todas sus preguntas. Esta acción no se puede deshacer.">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button
                      class="btn btn-secondary professor-danger" title="Eliminar examen"
                      aria-label="Eliminar <%= exam.title %>"><i class="ti ti-trash" aria-hidden="true"></i></button>
                  </form>
                </div>
              </article>
              <% }) %>
          </div>
          <% } %>
            <% } %>
              <%- include('../partials/professor-footer') %>