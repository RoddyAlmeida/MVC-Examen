<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
    <main class="container app-shell" style="max-width: 800px;">
        <div class="theme-toggle-wrapper">
            <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar modo de color"><i class="ti ti-moon"
                    aria-hidden="true"></i></button>
        </div>
        <header class="page-header">
            <a href="/professor/dashboard" class="btn btn-secondary" style="margin-bottom: 1rem; width: fit-content;"><i
                    class="ti ti-arrow-left" aria-hidden="true"></i> Volver</a>
            <p class="eyebrow"><i class="ti ti-notes" aria-hidden="true"></i>
                <%= exam.title %>
            </p>
            <h1>Gestionar preguntas</h1>
        </header>
        <% if (errors.length) { %>
            <div class="alert alert-error" role="alert">
                <ul>
                    <% errors.forEach((error)=> { %><li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>
                <section class="panel">
                    <h2 style="margin: 0 0 1rem;"><i class="ti ti-list" aria-hidden="true"></i> Preguntas (<%=
                            questions.length %>/100)</h2>
                    <% if (questions.length < 100) { %>
                        <a class="btn btn-primary" href="/professor/exams/<%= exam.id %>/questions/create"><i
                                class="ti ti-plus" aria-hidden="true"></i> Agregar pregunta</a>
                        <% } else { %>
                            <p><i class="ti ti-lock" aria-hidden="true"></i> Límite de 100 preguntas alcanzado.</p>
                            <% } %>
                </section>
                <% if (questions.length) { %>
                    <section>
                        <h2><i class="ti ti-list" aria-hidden="true"></i> Preguntas actuales</h2>
                        <div class="exam-list">
                            <% questions.forEach((question, index)=> { %>
                                <article class="exam-card">
                                    <div class="exam-card-body">
                                        <h3 class="exam-card-title">
                                            <%= index + 1 %>. <%= question.prompt %>
                                        </h3>
                                        <p class="exam-card-meta">
                                            <%= question.content ? question.content.type.replaceAll('_', ' ' )
                                                : 'Opción múltiple' %>
                                        </p>
                                    </div>
                                    <div class="exam-card-actions">
                                        <a class="btn btn-secondary"
                                            href="/professor/exams/<%= exam.id %>/questions/<%= question.id %>/edit"
                                            aria-label="Editar pregunta <%= index + 1 %>"><i class="ti ti-edit"
                                                aria-hidden="true"></i></a>
                                        <form method="POST"
                                            action="/professor/exams/<%= exam.id %>/questions/<%= question.id %>/delete"
                                            onsubmit="return confirm('¿Eliminar esta pregunta?')">
                                            <button class="btn btn-secondary" style="color: var(--danger);"
                                                aria-label="Eliminar pregunta <%= index + 1 %>"><i class="ti ti-trash"
                                                    aria-hidden="true"></i></button>
                                        </form>
                                    </div>
                                </article>
                                <% }) %>
                        </div>
                    </section>
                    <% } %>
    </main>
    <script src="/js/themeToggle.js"></script>
</body>

</html>