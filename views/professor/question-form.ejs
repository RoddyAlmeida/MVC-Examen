<%- include('../partials/professor-header', { pageHeading: exam.title }) %>
    <a href="/professor/dashboard?courseId=<%= exam.courseId %>" class="professor-back"><i class="ti ti-arrow-left"
            aria-hidden="true"></i> Mis exámenes</a>
    <%- include('../partials/exam-workflow', { currentStep: 'questions' }) %>
        <% if (errors.length) { %>
            <div class="alert alert-error" role="alert">
                <ul>
                    <% errors.forEach(error=> { %><li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>
                <div class="professor-toolbar">
                    <div>
                        <h2>Preguntas del examen</h2><span class="professor-muted">
                            <%= questions.length %> de 100
                        </span>
                    </div>
                    <div class="professor-actions"><a href="/professor/exams/<%= exam.id %>/access"
                            class="btn btn-secondary"><i class="ti ti-lock-access" aria-hidden="true"></i> Configurar
                            acceso</a>
                        <% if (questions.length < 100) { %><a class="btn btn-primary"
                                href="/professor/exams/<%= exam.id %>/questions/create"><i class="ti ti-plus"
                                    aria-hidden="true"></i> Añadir pregunta</a>
                            <% } %>
                    </div>
                </div>
                <% if (!questions.length) { %>
                    <section class="professor-empty"><i class="ti ti-notes" aria-hidden="true"></i>
                        <h2>Añade la primera pregunta</h2>
                        <p>Este examen todavía no tiene preguntas.</p><a class="btn btn-primary"
                            href="/professor/exams/<%= exam.id %>/questions/create"><i class="ti ti-plus"
                                aria-hidden="true"></i> Añadir pregunta</a>
                    </section>
                    <% } else { %>
                        <% const questionLabels={ multiple_choice: 'Opción múltiple' , true_false: 'Verdadero o falso' ,
                            fill_text: 'Completar escribiendo' , fill_drag: 'Completar arrastrando' ,
                            concept: 'Desarrollo' , crossword: 'Crucigrama' }; %>
                            <ol class="professor-question-list">
                                <% questions.forEach((question, index)=> { %>
                                    <li class="professor-question-row"><span class="professor-question-number">
                                            <%= index + 1 %>
                                        </span>
                                        <div class="professor-exam-content">
                                            <h3>
                                                <%= question.prompt %>
                                            </h3><span class="professor-muted">
                                                <%= questionLabels[question.content?.type || 'multiple_choice' ]
                                                    || 'Pregunta' %>
                                            </span>
                                        </div>
                                        <div class="professor-actions"><a
                                                href="/professor/exams/<%= exam.id %>/questions/<%= question.id %>/edit"
                                                class="btn btn-secondary" title="Editar pregunta"
                                                aria-label="Editar pregunta <%= index + 1 %>"><i class="ti ti-edit"
                                                    aria-hidden="true"></i></a>
                                            <form
                                                action="/professor/exams/<%= exam.id %>/questions/<%= question.id %>/delete"
                                                method="POST"
                                                data-confirm-message="Se eliminará esta pregunta del examen."><input
                                                    type="hidden" name="_csrf" value="<%= csrfToken %>" /><button
                                                    class="btn btn-secondary professor-danger" title="Eliminar pregunta"
                                                    aria-label="Eliminar pregunta <%= index + 1 %>"><i
                                                        class="ti ti-trash" aria-hidden="true"></i></button></form>
                                        </div>
                                    </li>
                                    <% }) %>
                            </ol>
                            <% if (questions.length>= 100) { %><p class="professor-muted" role="status">Límite de 100
                                    preguntas alcanzado.</p>
                                <% } %>
                                    <% } %>
                                        <%- include('../partials/professor-footer') %>