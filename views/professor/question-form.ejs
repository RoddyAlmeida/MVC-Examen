<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="container app-shell" style="max-width: 800px;">
      <div class="theme-toggle-wrapper">
        <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar modo de color">
          <i class="ti ti-moon" aria-hidden="true"></i>
        </button>
      </div>

      <header class="page-header">
        <a href="/professor/dashboard" class="btn btn-secondary" style="margin-bottom: 1rem; width: fit-content;">
          <i class="ti ti-arrow-left" aria-hidden="true"></i> Volver
        </a>
        <p class="eyebrow"><i class="ti ti-notes" aria-hidden="true"></i> <%= exam.title %></p>
        <h1>Gestionar preguntas</h1>
      </header>

      <% if (errors.length > 0) { %>
      <div class="alert alert-error" role="alert">
        <i class="ti ti-alert-circle alert-icon" aria-hidden="true"></i>
        <div class="alert-content">
          <ul>
            <% errors.forEach((error) => { %>
            <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      </div>
      <% } %>

      <section class="panel toggle-section">
        <div class="toggle-header" onclick="this.nextElementSibling.classList.toggle('hidden'); this.querySelector('.toggle-icon').classList.toggle('ti-chevron-down'); this.querySelector('.toggle-icon').classList.toggle('ti-chevron-up')">
          <h2 style="margin: 0; flex: 1;"><i class="ti ti-plus" aria-hidden="true"></i> Agregar pregunta</h2>
          <span style="font-size: 0.85rem; color: var(--text-secondary); margin-right: 0.5rem;">click para expandir</span>
          <i class="ti ti-chevron-down toggle-icon" style="font-size: 1.5rem; color: var(--text-secondary); transition: transform 0.2s ease;"></i>
        </div>
        <form method="POST" action="/professor/exams/<%= exam.id %>/questions/create" class="hidden">
          <div class="form-group">
            <label for="prompt" class="form-label">Enunciado</label>
            <textarea id="prompt" name="prompt" class="form-input form-textarea" rows="2" placeholder="Ej: ¿Qué principio reduce la sobrecarga de memoria en la pantalla?" required></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="optionA" class="form-label">Opción A</label>
              <input type="text" id="optionA" name="optionA" class="form-input" placeholder="Texto de la opción A" required />
            </div>
            <div class="form-group">
              <label for="optionB" class="form-label">Opción B</label>
              <input type="text" id="optionB" name="optionB" class="form-input" placeholder="Texto de la opción B" required />
            </div>
            <div class="form-group">
              <label for="optionC" class="form-label">Opción C</label>
              <input type="text" id="optionC" name="optionC" class="form-input" placeholder="Texto de la opción C" required />
            </div>
          </div>
          <div class="form-group">
            <label for="correctOption" class="form-label">Opción correcta</label>
            <select id="correctOption" name="correctOption" class="form-input" required>
              <option value="">Seleccionar...</option>
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="ti ti-plus" aria-hidden="true"></i> Agregar pregunta
          </button>
        </form>
      </section>

      <% if (questions.length > 0) { %>
      <section>
        <h2><i class="ti ti-list" aria-hidden="true"></i> Preguntas actuales (<%= questions.length %>)</h2>
        <% questions.forEach((q, i) => { %>
        <article class="question-card question-card-editable" style="padding: 1.25rem;">
          <div class="question-card-view" onclick="this.closest('.question-card-editable').querySelector('.edit-form').classList.toggle('hidden'); return false;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
              <div style="flex: 1; min-width: 0;">
                <p style="font-weight: 600; margin-bottom: 0.5rem; word-break: break-word;"><%= i + 1 %>. <%= q.prompt %></p>
                <div style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.8;">
                  <span><strong>A:</strong> <%= q.optionA %></span><br />
                  <span><strong>B:</strong> <%= q.optionB %></span><br />
                  <span><strong>C:</strong> <%= q.optionC %></span><br />
                  <span style="color: var(--success); font-weight: 600;">✓ Correcta: <%= q.correctOption %></span>
                </div>
              </div>
              <div style="display: flex; gap: 0.5rem; flex-shrink: 0;" onclick="event.stopPropagation()">
                <form method="POST" action="/professor/exams/<%= exam.id %>/questions/<%= q.id %>/delete" onsubmit="return confirm('¿Eliminar esta pregunta?')">
                  <button class="btn btn-secondary" style="color: var(--danger);" title="Eliminar pregunta">
                    <i class="ti ti-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
          <form method="POST" action="/professor/exams/<%= exam.id %>/questions/<%= q.id %>/edit" class="edit-form panel hidden" style="margin-top: 1rem;">
            <div class="form-group">
              <label class="form-label">Enunciado</label>
              <input type="text" name="prompt" value="<%= q.prompt %>" class="form-input" required />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">A</label>
                <input type="text" name="optionA" value="<%= q.optionA %>" class="form-input" required />
              </div>
              <div class="form-group">
                <label class="form-label">B</label>
                <input type="text" name="optionB" value="<%= q.optionB %>" class="form-input" required />
              </div>
              <div class="form-group">
                <label class="form-label">C</label>
                <input type="text" name="optionC" value="<%= q.optionC %>" class="form-input" required />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Opción correcta</label>
              <select name="correctOption" class="form-input" required>
                <option value="A" <%= q.correctOption === 'A' ? 'selected' : '' %>>A</option>
                <option value="B" <%= q.correctOption === 'B' ? 'selected' : '' %>>B</option>
                <option value="C" <%= q.correctOption === 'C' ? 'selected' : '' %>>C</option>
              </select>
            </div>
            <div style="display: flex; gap: 0.75rem;">
              <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> Guardar cambios
              </button>
              <button type="button" class="btn btn-secondary" onclick="this.closest('.edit-form').classList.add('hidden')">Cancelar</button>
            </div>
          </form>
        </article>
        <% }) %>
      </section>
      <% } %>
    </main>
    <script src="/js/themeToggle.js"></script>
  </body>
</html>
