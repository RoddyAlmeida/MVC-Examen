<%- include('../partials/professor-header', { pageHeading: 'Importar examen' }) %>
    <a href="/professor/dashboard" class="professor-back"><i class="ti ti-arrow-left" aria-hidden="true"></i> Mis
        exámenes</a>
    <% if (errors.length) { %>
        <div class="alert alert-error" role="alert">
            <ul>
                <% errors.forEach((error)=> { %><li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
        </div>
        <% } %>
            <div class="exam-builder-layout">
                <section>
                    <form method="POST" action="/professor/exams/import" enctype="multipart/form-data"
                        id="examImportForm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <div class="form-group">
                            <label class="form-label" for="courseId">Curso</label>
                            <select id="courseId" name="courseId" class="form-input" required>
                                <option value="">Seleccionar curso</option>
                                <% courses.forEach(course=> { %>
                                    <option value="<%= course.id %>" <%=String(formData.courseId || ''
                                        )===String(course.id) ? 'selected' : '' %>><%= course.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="qtiPackage">Paquete QTI 3 (.zip)</label>
                            <input id="qtiPackage" name="qtiPackage" class="form-input" type="file"
                                accept=".zip,application/zip" aria-describedby="importStatus" required>
                            <p id="importStatus" class="assistive-status" role="status" aria-live="polite">Elige un
                                paquete ZIP de hasta 10 MB.</p>
                        </div>
                        <button type="submit" id="importSubmit" class="btn btn-primary" disabled><i class="ti ti-upload"
                                aria-hidden="true"></i> Importar paquete QTI</button>
                    </form>
                </section>
                <aside class="exam-builder-aside">
                    <h2>Paquete de evaluación</h2>
                    <dl>
                        <div>
                            <dt>Formato</dt>
                            <dd>QTI 3 · ZIP</dd>
                        </div>
                        <div>
                            <dt>Tamaño máximo</dt>
                            <dd>10 MB</dd>
                        </div>
                        <div>
                            <dt>Contenido</dt>
                            <dd>Hasta 100 preguntas</dd>
                        </div>
                    </dl>
                </aside>
            </div>
            <script src="/js/examImport.js" defer></script>
            <%- include('../partials/professor-footer') %>