<%- include('../partials/professor-header', { activeSection: 'students' , pageHeading: 'Estudiantes' }) %>
  <div class="professor-section-heading">
    <h2>Estudiantes de tus cursos</h2><span class="professor-muted">
      <%= students.length %> en total
    </span>
  </div>
  <% if (!students.length) { %>
    <section class="professor-empty"><i class="ti ti-users" aria-hidden="true"></i>
      <h2>Sin estudiantes todavía</h2>
      <p>No hay estudiantes vinculados a tus cursos.</p>
    </section>
    <% } else { %>
      <div class="workflow-table-scroll">
        <table class="workflow-table">
          <thead>
            <tr>
              <th scope="col">Estudiante</th>
              <th scope="col">Correo electrónico</th>
              <th scope="col">Seguimiento</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(student=> { %><tr>
                <td><strong>
                    <%= student.name || 'Sin nombre' %>
                  </strong></td>
                <td>
                  <%= student.email %>
                </td>
                <td><a href="/professor/students/<%= student.id %>" class="btn btn-secondary">Ver resultados <i
                      class="ti ti-arrow-right" aria-hidden="true"></i></a></td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
        <%- include('../partials/professor-footer') %>