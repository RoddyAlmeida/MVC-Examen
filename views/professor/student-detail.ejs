<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
  <main class="container app-shell" style="max-width: 800px;">
    <div class="theme-toggle-wrapper">
      <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar modo de color">
        <i class="ti ti-moon" aria-hidden="true"></i>
      </button>
    </div>

    <header class="page-header"
      style="display: flex; justify-content: space-between; align-items: flex-start; padding-right: 3rem; padding-top: 1.5rem;">
      <div>
        <p class="eyebrow"><i class="ti ti-users" aria-hidden="true"></i>
          <%= student.email %>
        </p>
        <h1>
          <%= student.name || 'Sin nombre' %>
        </h1>
      </div>
      <div class="header-actions">
        <a href="/professor/students" class="btn btn-secondary">
          <i class="ti ti-arrow-left" aria-hidden="true"></i> Volver
        </a>
        <button class="btn btn-secondary" onclick="document.getElementById('edit-modal').classList.add('modal--open')">
          <i class="ti ti-edit"></i> Editar datos
        </button>
        <form method="POST" action="/professor/students/<%= student.id %>/delete" style="display: inline;"
          onsubmit="return confirm('¿Eliminar permanentemente a <%= student.name || student.email %>? También se borrarán todos sus resultados.');">
          <button class="btn btn-secondary" style="color: var(--danger);" title="Eliminar estudiante">
            <i class="ti ti-trash"></i>
          </button>
        </form>
      </div>
    </header>

    <% if (req.query.error) { %>
      <div class="alert alert-error" role="alert">
        <i class="ti ti-alert-circle alert-icon" aria-hidden="true"></i>
        <div class="alert-content">
          <p>
            <%= req.query.error %>
          </p>
        </div>
      </div>
      <% } %>

        <h2 style="margin-top: 2rem;"><i class="ti ti-clipboard-check" aria-hidden="true"></i> Resultados por examen
        </h2>

        <% if (results.length===0) { %>
          <section class="panel" style="text-align: center; padding: 2rem;">
            <i class="ti ti-chart-bar-off"
              style="font-size: 2rem; color: var(--text-secondary); margin-bottom: 1rem; display: block;"></i>
            <p style="color: var(--text-secondary);">Este estudiante aún no ha rendido ningún examen.</p>
          </section>
          <% } else { %>
            <div class="exam-list">
              <% results.forEach((r)=> { %>
                <article class="exam-card" style="flex-wrap: wrap;">
                  <a href="/professor/students/<%= student.id %>/exam/<%= r.examId %>"
                    style="display: flex; flex: 1; text-decoration: none; align-items: center; gap: 1rem;">
                    <div class="exam-card-body" style="flex: 1;">
                      <h2 class="exam-card-title">
                        <%= r.exam ? r.exam.title : 'Examen #' + r.examId %>
                      </h2>
                      <div style="display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem;">
                        <div class="score-display" style="font-size: 1.25rem; margin: 0;">
                          <span class="score-value">
                            <%= r.score %>
                          </span>
                          <span class="score-total">/ <%= r.total %></span>
                        </div>
                        <span
                          style="color: var(--<%= r.score >= r.total * 0.6 ? 'success' : 'danger' %>); font-weight: 600;">
                          <%= Math.round((r.score / r.total) * 100) %>%
                        </span>
                        <span style="color: var(--text-secondary); font-size: 0.85rem;">
                          <%= r.createdAt.toLocaleDateString() %>
                        </span>
                        <% if (r.pendingReview> 0) { %>
                          <span style="color: var(--primary); font-size: 0.85rem;"><i class="ti ti-clock"
                              aria-hidden="true"></i>
                            <%= r.pendingReview %> pendiente(s)
                          </span>
                          <% } %>
                      </div>
                    </div>
                    <i class="ti ti-chevron-right" style="font-size: 1.5rem; color: var(--text-secondary);"></i>
                  </a>
                  <form method="POST" action="/professor/students/<%= student.id %>/reset-exam/<%= r.examId %>"
                    onsubmit="return confirm('¿Resetear este resultado? El estudiante podrá volver a rendir el examen.');">
                    <button class="btn btn-secondary" style="color: var(--danger);">
                      <i class="ti ti-refresh"></i> Reset
                    </button>
                  </form>
                </article>
                <% }) %>
            </div>
            <% } %>
  </main>

  <div id="edit-modal" class="modal-overlay" onclick="if (event.target===this) this.classList.remove('modal--open')">
    <div class="modal-box">
      <div class="modal-header">
        <h3><i class="ti ti-edit" aria-hidden="true"></i> Editar datos</h3>
        <button class="btn btn-secondary"
          onclick="document.getElementById('edit-modal').classList.remove('modal--open')" aria-label="Cerrar">
          <i class="ti ti-x"></i>
        </button>
      </div>
      <form method="POST" action="/professor/students/<%= student.id %>/edit">
        <div class="form-group">
          <label class="form-label">Nombre</label>
          <input type="text" name="name" value="<%= student.name || '' %>" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">Correo</label>
          <input type="email" name="email" value="<%= student.email %>" class="form-input" required />
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary"
            onclick="document.getElementById('edit-modal').classList.remove('modal--open')">Cancelar</button>
          <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/themeToggle.js"></script>
</body>

</html>