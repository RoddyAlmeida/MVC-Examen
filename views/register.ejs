<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/student.css" />
</head>

<body class="auth-page">
  <header class="auth-topbar">
    <a href="/login" class="app-brand"><span class="brand-mark"><i class="ti ti-school" aria-hidden="true"></i></span>
      MVC Examen</a>
    <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar modo de color" title="Cambiar modo de color">
      <i class="ti ti-moon" aria-hidden="true"></i>
    </button>
  </header>
  <main class="auth-main">
    <header class="auth-heading">
      <p class="eyebrow">Tu espacio de aprendizaje</p>
      <h1>Crear cuenta</h1>
      <p>Un nuevo comienzo.</p>
    </header>

    <% if (typeof error !=='undefined' && error) { %>
      <div class="alert alert-error" role="alert">
        <i class="ti ti-alert-circle alert-icon" aria-hidden="true"></i>
        <div class="alert-content">
          <p>
            <%= error %>
          </p>
        </div>
      </div>
      <% } %>

        <form method="POST" action="/register">
          <div class="form-group">
            <label for="name" class="form-label">Nombre (opcional)</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="Tu nombre" autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Correo electrónico</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="correo@ejemplo.com"
              autocomplete="username" required />
          </div>
          <div class="form-group">
            <label for="password" class="form-label">Contraseña</label>
            <input type="password" id="password" name="password" class="form-input" placeholder="Mínimo 4 caracteres"
              autocomplete="new-password" minlength="4" required />
          </div>
          <button type="submit" class="btn btn-primary auth-submit">
            <i class="ti ti-user-plus" aria-hidden="true"></i> Crear cuenta
          </button>
        </form>

        <p class="auth-switch">
          ¿Ya tienes cuenta?
          <a href="/login">Iniciar sesión</a>
        </p>
  </main>
  <footer class="auth-footer"><span>MVC Examen</span><span>Espacio académico</span></footer>
  <%- include('partials/page-feedback') %>
    <script src="/js/themeToggle.js"></script>
</body>

</html>